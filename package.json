{
  "name": "notification-preferences-service",
  "version": "1.0.0",
  "description": "Service for managing user notification preferences",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && npm run copy:migrations",
    "copy:migrations": "cp -r src/infrastructure/database/migrations dist/src/infrastructure/database/",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/infrastructure/database/migrate.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "luxon": "^3.4.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/luxon": "^3.4.2",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.1",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "supertest": "^6.3.3"
  }
}
